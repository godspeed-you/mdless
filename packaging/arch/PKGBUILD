# Maintainer: Marcel Arentz <gdspd_you@open-one.de>
pkgname=mdless
pkgver=0.2.0
pkgrel=1
pkgdesc="Interactive terminal Markdown reader with semantic navigation, folding, tables and Mermaid diagrams"
arch=('x86_64' 'aarch64')
url="https://github.com/godspeed-you/mdless"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo' 'gcc')
optdepends=(
  'mermaid-cli: image rendering of Mermaid diagrams that the built-in renderer does not support'
  'xdg-utils: opening links from the document'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export INSTA_UPDATE=no
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm0755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"

  # Generated by the binary itself, so they can never drift from the CLI.
  "target/release/$pkgname" --generate-man > "$pkgname.1"
  install -Dm0644 "$pkgname.1" "$pkgdir/usr/share/man/man1/$pkgname.1"

  "target/release/$pkgname" --generate-completions bash > "$pkgname.bash"
  "target/release/$pkgname" --generate-completions zsh  > "_$pkgname"
  "target/release/$pkgname" --generate-completions fish > "$pkgname.fish"
  install -Dm0644 "$pkgname.bash" "$pkgdir/usr/share/bash-completion/completions/$pkgname"
  install -Dm0644 "_$pkgname"     "$pkgdir/usr/share/zsh/site-functions/_$pkgname"
  install -Dm0644 "$pkgname.fish" "$pkgdir/usr/share/fish/vendor_completions.d/$pkgname.fish"

  install -Dm0644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm0644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
  install -Dm0644 docs/configuration.md "$pkgdir/usr/share/doc/$pkgname/configuration.md"
  install -Dm0644 docs/keybindings.md "$pkgdir/usr/share/doc/$pkgname/keybindings.md"
  install -Dm0644 docs/mermaid.md "$pkgdir/usr/share/doc/$pkgname/mermaid.md"
  install -Dm0644 docs/terminal-compatibility-checklist.md \
    "$pkgdir/usr/share/doc/$pkgname/terminal-compatibility-checklist.md"
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
